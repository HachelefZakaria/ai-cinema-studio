# Set only the credential for the provider you select in main.py.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Local Ollama does not require an API key by default.

# Image generation providers (only required with --generate-images)
STABILITY_API_KEY=
REPLICATE_API_TOKEN=

# Video generation (optional; required only with --generate-videos)
RUNWAYML_API_SECRET=
# REPLICATE_API_TOKEN above is also used for Replicate image/video models.

# Audio generation (optional; required only with --generate-audio)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# OpenAI TTS can also use OPENAI_API_KEY above. OpenAI adapter generates TTS only;
# ElevenLabs adapter supports TTS, sound effects, and instrumental music.
